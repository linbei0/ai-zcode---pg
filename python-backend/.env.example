# 应用基础配置
AIZCODE_APP_NAME=ai-zcode-python-backend
AIZCODE_API_PREFIX=/api
AIZCODE_PUBLIC_API_BASE_URL=http://localhost:8335/api

# CORS，必须使用 JSON 数组格式
AIZCODE_CORS_ORIGINS=["http://localhost:5173"]

# 数据源与缓存
AIZCODE_DATABASE_URL=postgresql+psycopg://postgres:root@localhost:5432/ai_zcode
AIZCODE_REDIS_URL=redis://localhost:6379/0

# 会话配置
AIZCODE_SESSION_SECRET=change-this-session-secret
AIZCODE_SESSION_COOKIE_NAME=aizcode_session
AIZCODE_SESSION_TTL_SECONDS=2592000

# AI 配置
AIZCODE_OPENAI_API_KEY=
AIZCODE_OPENAI_BASE_URL=
AIZCODE_OPENAI_MODEL=gpt-4.1-mini

# 运行模式
AIZCODE_TESTING=false

# 部署与目录
AIZCODE_CODE_DEPLOY_HOST=http://localhost

# 缓存
AIZCODE_GOOD_APP_CACHE_TTL_SECONDS=300
AIZCODE_APP_VO_CACHE_TTL_SECONDS=300

# 限流（聊天生成）
AIZCODE_CHAT_RATE_LIMIT=5
AIZCODE_CHAT_RATE_INTERVAL_SECONDS=60

# 封面资源
AIZCODE_SCREENSHOT_WIDTH=1600
AIZCODE_SCREENSHOT_HEIGHT=900
AIZCODE_SCREENSHOT_TIMEOUT_SECONDS=30
AIZCODE_COS_SECRET_ID=
AIZCODE_COS_SECRET_KEY=
AIZCODE_COS_REGION=ap-shanghai
AIZCODE_COS_BUCKET=
AIZCODE_COS_HOST=

# Vue 构建命令
AIZCODE_VUE_INSTALL_COMMAND=npm install
AIZCODE_VUE_BUILD_COMMAND=npm run build
